# Copy this file to a new file named ".env" and fill in real values.
# NEVER commit .env and never paste these values into chat or source code.

# General
APP_ENV=development
LOG_LEVEL=INFO

# Telegram (needed from Phase 2). Get it from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (your own ID first).
ADMIN_USER_IDS=

# Anthropic API (needed from Phase 3). Paid, usage-based, separate from a Claude subscription.
ANTHROPIC_API_KEY=

# Database. SQLite file for the local prototype. PostgreSQL (e.g. Supabase) can be used later.
DATABASE_URL=sqlite:///data/assistant.db

# Time zone used for deadlines and the word today
TIMEZONE=Africa/Lagos

# Limits (safe defaults)
HISTORY_MESSAGE_LIMIT=20
CRYPTO_LOOKUPS_PER_5_MIN=8
IMAGE_GENERATIONS_PER_DAY=2
MAX_IMAGE_MB=10
MAX_VOICE_SECONDS=120
MAX_VOICE_MB=20
